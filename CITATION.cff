# Citation metadata for EXOZIPPy. GitHub's "Cite this repository" button is
# built from this file, and Zenodo's GitHub integration takes the creators of
# each future release's software record from it -- edit it here (authors,
# affiliations, ORCIDs) to change both.
cff-version: 1.2.0
message: "If you use EXOZIPPy, please cite it using this metadata, and cite each Zenodo data record your fit uses."
type: software
title: "EXOZIPPy"
license: BSD-3-Clause
repository-code: "https://github.com/jdeast/EXOZIPPy"
# Concept DOI of the GitHub-release software record: it always resolves to
# the latest release. For reproducibility, cite the version DOI of the
# release you used (v0.1.0rc2 is 10.5281/zenodo.22779459).
doi: 10.5281/zenodo.21630654
