# /bin/sh
# ----------------Parameters---------------------- #
#$ -S /bin/sh
#$ -pe mthread 8
#$ -q mThC.q
#$ -cwd
#$ -j y
#$ -N exozippy_tests
#$ -o run_tests.$JOB_ID.log
#
# Run the pytest suite on an SGE compute node (Hydra) instead of the login
# node.  From the repo root:
#
#   qsub scripts/run_tests.job                      # the full suite
#   qsub -v ARGS="tests/test_ptde.py -n0 -x" scripts/run_tests.job
#
# ARGS is passed to pytest verbatim, so a targeted rerun needs no copy of
# this file.  The log lands in the submission directory (-cwd).

module purge
module load tools/python/3.13

export PATH="$HOME/miniconda3/bin:$PATH:$HOME/.local/bin"

source $HOME/miniconda3/etc/profile.d/conda.sh
conda activate exozippy

# PyTensor's C-module compile cache uses fcntl.flock() for its lock file.
# $HOME is NFS-mounted here, and this cluster's NFS client doesn't honor
# advisory locks reliably (ENOLCK / ESTALE mid-compile, which fabricates
# failures in unrelated components under -n6).  Point the cache at the job's
# local-disk scratch instead.  The repo-root conftest.py sees base_compiledir
# set here and leaves it alone (docs/testing-cache.md).
export PYTENSOR_FLAGS="base_compiledir=${TMPDIR:-/tmp}/pytensor"

cd $HOME/python/EXOZIPPy

git log --oneline -1
which python
python -u -m pytest $ARGS
