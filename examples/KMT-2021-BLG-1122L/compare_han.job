# /bin/sh
#$ -S /bin/sh
#$ -pe mthread 4
#$ -q mThM.q
#$ -l use_himem=TRUE
#$ -cwd
#$ -j y
#$ -N kmt1122cmp
#$ -o fitresults_sync_slowtail/compare_han.$JOB_ID.log
module purge
module load tools/python/3.13
export PATH="$HOME/miniconda3/bin:$PATH:$HOME/.local/bin"
source $HOME/miniconda3/etc/profile.d/conda.sh
conda activate exozippy
export OMP_NUM_THREADS=4
cd $HOME/python/EXOZIPPy/examples/KMT-2021-BLG-1122L
echo "commit $(git -C $HOME/python/EXOZIPPy rev-parse --short HEAD)   $(date)"
python -u compare_han.py fitresults_sync_slowtail KMT-2021-BLG-1122L 4959 2>&1 | grep -v "DEBUG\|Warning\|warn\|^\["
echo "exit $?   $(date)"
