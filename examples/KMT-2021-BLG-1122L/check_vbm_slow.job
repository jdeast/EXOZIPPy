# /bin/sh
#$ -S /bin/sh
#$ -pe mthread 16
#$ -q mThM.q
#$ -l use_himem=TRUE
#$ -cwd
#$ -j y
#$ -N kmt1122slow
#$ -o vbmfix_results/slowtail/check_vbm_slow.$JOB_ID.log
module purge
module load tools/python/3.13
export PATH="$HOME/miniconda3/bin:$PATH:$HOME/.local/bin"
source $HOME/miniconda3/etc/profile.d/conda.sh
conda activate exozippy
export PYTENSOR_FLAGS="base_compiledir=${TMPDIR:-/tmp}/pytensor_kmt1122vbm"
cd $HOME/python/EXOZIPPy/examples/KMT-2021-BLG-1122L/vbmfix_results/slowtail
echo "commit $(git -C $HOME/python/EXOZIPPy rev-parse --short HEAD)   $(date)"
python -u check_vbm_crash.py 12000 1 16 Multipoly 2>&1 | grep -v "DEBUG\|Warning\|warn"
echo "exit $?   $(date)"
