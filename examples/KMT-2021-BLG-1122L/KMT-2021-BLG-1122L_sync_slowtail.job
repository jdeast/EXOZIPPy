# /bin/sh
#$ -S /bin/sh
#$ -pe mthread 32-64
#$ -q lThM.q
#$ -l use_himem=TRUE
#$ -cwd
#$ -j y
#$ -N kmt1122sync
#$ -o fitresults_sync_slowtail/KMT-2021-BLG-1122L.$JOB_ID.log
#
# Review 7.6.4: the triple-lens acceptance fit, SYNCHRONOUS ptde, under
# VBMicrolensing PR #75 (Newton-polish slow-tail fix, ~/vbm_slowtail_venv).
# Runs alongside the async fit (job 15513700).  Was: UNDER THE FIXED VBM KERNEL
# (valboz/VBMicrolensing#74 built into ~/vbm_fix_venv, review 2.6.35); the
# shared env still has pip VBM 5.5.  Otherwise (Han+2023 3L1S), started at
# the convention-scan winner in the params file.  Targets: Table 2's
# (s_2, q_2, alpha, s_3, q_3, psi, rho, t_E) through the mappings in the
# README, and the physical lens masses under the IMF + galactic priors.

module purge
module load tools/python/3.13
export PATH="$HOME/miniconda3/bin:$PATH:$HOME/.local/bin"
source $HOME/miniconda3/etc/profile.d/conda.sh
conda activate exozippy
export PYTENSOR_FLAGS="base_compiledir=${TMPDIR:-/tmp}/pytensor_kmt1122"

cd $HOME/python/EXOZIPPy/examples/KMT-2021-BLG-1122L
[ -f vbmfix_results/slowtailfix/PASS ] || { echo "PR #75 build did not pass verification; not fitting"; exit 1; }
mkdir -p fitresults_sync_slowtail
echo "commit $(git -C $HOME/python/EXOZIPPy rev-parse --short HEAD) on $(git -C $HOME/python/EXOZIPPy branch --show-current)   $(date)   slots $NSLOTS"
# The shipped config keeps RELATIVE paths (run.py resolves them against the
# working directory), so the cores-set copy lives in fitresults/ and the fit
# runs from here; dc18_set_cores.py refuses relative paths by design.
cfg="fitresults_sync_slowtail/KMT-2021-BLG-1122L.cores${NSLOTS:?NSLOTS unset}.yaml"
python - "$cfg" "$NSLOTS" <<'PY'
import sys, yaml
cfg, n = sys.argv[1], int(sys.argv[2])
d = yaml.safe_load(open("KMT-2021-BLG-1122L.yaml"))
d.setdefault("sampler", {})["cores"] = n
d["prefix"] = "fitresults_sync_slowtail/KMT-2021-BLG-1122L"
# Starts seeded at the convention scan's optimum (seed_from_optimum.py; start
# lp 9285 against -10808 from the plain params file, whose population had to
# climb and froze the cold rungs at step size 0.003).
d["parameter_file"] = "KMT-2021-BLG-1122L.params.scanopt.yaml"
# The T_max 20 workaround of the shipped config is for the UNFIXED kernel:
# under the fixed one the full ladder comes back.  start_dispersion 3.0
# STAYS: with the auto 3*sqrt(T) the serial, untimed start scoring (review
# 2.6.36) took an hour per rung from rung 5 on even with the fixed kernel
# (job 15507641: rung 10 after 5h40 on one core, no hangs), while at 3.0
# the whole init takes minutes; the hot rungs disperse during tuning
# anyway.  seed_polish stays off (the polish has no timeout and the fixed
# Multipoly keeps a ~1.7e-4 tail of multi-minute calls); the s bounds stay
# (a physical prior here).
d["sampler"]["T_max"] = 200
# The SYNCHRONOUS engine waits for every proposal of a step: under the fixed
# kernel the sixth launch (job 15511416) saw 649 ten-second eval_timeouts
# in its first 173 steps on EVERY rung (3.75 per step, 1.7e-3 per call --
# the fixed Multipoly's slow-but-finite 20-100 s calls, ten times the
# > 120 s tail the stress test counted) and 122 pool recycles, 37 s per
# step, a ten-day run.  ptde_async exists for exactly a straggler tail (a
# slow call costs one worker, not the step; samplers.md), so this fit uses
# it, with eval_timeout raised to 300 s so a slow call finishes instead of
# killing the pool.  The sync default's premise (the VBM tail is gone) is
# a binary-lens measurement; it does not hold for three bodies.
# SYNCHRONOUS ptde, the shipped default (#376): with PR #75's Newton polish
# the fixed kernel's minutes-long Multipoly calls are gone (the 4 slow cases
# drop to < 1 s on radish), which was the only reason for ptde_async.
d["sampler"]["method"] = "ptde"
d["sampler"]["eval_timeout"] = 60
d["sampler"].pop("log_interval", None)
print("sync_slowtail overrides: T_max 200, start_dispersion 3.0, method ptde, eval_timeout 60")
yaml.safe_dump(d, open(cfg, "w"), sort_keys=False)
print(f"wrote {cfg} with sampler.cores = {n}")
PY
/usr/bin/time -v $HOME/vbm_slowtail_venv/bin/python -c "import sys; from exozippy.cli import main; sys.exit(main())" "$cfg" 2> fitresults_sync_slowtail/time.txt
echo "exit $?   $(date)"
grep -E "Elapsed|Maximum resident" fitresults_sync_slowtail/time.txt
