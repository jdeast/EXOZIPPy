# /bin/sh
#$ -S /bin/sh
#$ -pe mthread 4
#$ -q mThM.q
#$ -l use_himem=TRUE
#$ -cwd
#$ -j y
#$ -N priorpct
#$ -o sweep4/dc18_prior_percentile.$JOB_ID.log
# Review 7.7.3 (1): the prior percentile of each sweep4 truth vs the fit's pull.
module purge
module load tools/python/3.13
export PATH="$HOME/miniconda3/bin:$PATH:$HOME/.local/bin"
source $HOME/miniconda3/etc/profile.d/conda.sh
conda activate exozippy
export PYTENSOR_FLAGS="base_compiledir=${TMPDIR:-/tmp}/pytensor_priorpct"
export OMP_NUM_THREADS=1
cd $HOME/python/EXOZIPPy/examples/DC2018
echo "commit $(git -C $HOME/python/EXOZIPPy rev-parse --short HEAD)   $(date)"
for ev in 047 069 103 152 194 223; do
  python -u dc18_prior_percentile.py --event $((10#$ev)) --run-dir sweep4/$ev 2>&1 | grep -v "DEBUG\|Warning\|warn\|^\[" 
done
echo "exit $?   $(date)"
