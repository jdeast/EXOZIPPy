# /bin/sh
#$ -S /bin/sh
#$ -pe mthread 8
#$ -q mThC.q
#$ -cwd
#$ -j y
#$ -N dc18full
#$ -o dc18_fullsuite.$JOB_ID.log
#
# Full EXOZIPPy suite after the polish changes (core sampler code).
# Persistent compile cache and NO output truncation -- both lessons from
# job 15326453, where a cold cache under load produced three spurious
# failures and `| tail -40` threw away the tracebacks.

module purge
module load tools/python/3.13
export PATH="$HOME/miniconda3/bin:$PATH:$HOME/.local/bin"
source $HOME/miniconda3/etc/profile.d/conda.sh
conda activate exozippy

export PYTENSOR_FLAGS="base_compiledir=${TMPDIR:-/tmp}/pytensor_merge"

cd $HOME/python/EXOZIPPy
python -m pytest -q
