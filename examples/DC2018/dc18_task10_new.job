# /bin/sh
#$ -S /bin/sh
#$ -pe mthread 4
#$ -q mThM.q
#$ -l use_himem=TRUE
#$ -cwd
#$ -j y
#$ -N task10new
#$ -o task10_old.$JOB_ID.log
#
# TASK 10 step 2: the NEW start logp (master code, converted configs; see step 1 header) of the 24 convertible DC2018 configs,
# on the pre-#361 tree (5679d1a7, worktree ~/wt_pre361, first on PYTHONPATH)
# reading the UNCONVERTED configs in the main checkout (their mmexofast:
# keys, JSONs and params as they stand).  Must finish before the converter
# rewrites those configs and params.

module purge
module load tools/python/3.13
export PATH="$HOME/miniconda3/bin:$PATH:$HOME/.local/bin"
source $HOME/miniconda3/etc/profile.d/conda.sh
conda activate exozippy
export PYTENSOR_FLAGS="base_compiledir=${TMPDIR:-/tmp}/pytensor_task10"
WT=$HOME/wt_pre361
export PYTHONPATH=
cd $HOME/python/EXOZIPPy/examples/DC2018
echo "old tree $(git -C $WT rev-parse --short HEAD); main tree $(git rev-parse --short HEAD) $(git branch --show-current)   $(date)"
python dc18_start_logp.py --scripts $HOME/python/EXOZIPPy/scripts --out task10/new $HOME/python/EXOZIPPy/examples/DC2018/configs/DC2018_128_mulens+sed+torres+mann.yaml $HOME/python/EXOZIPPy/examples/DC2018/configs/DC2018_128_mulens+sed+torres+mann_severed.yaml $HOME/python/EXOZIPPy/examples/DC2018/configs/DC2018_128_mulens+sed.yaml $HOME/python/EXOZIPPy/examples/DC2018/configs/DC2018_128_mulens.yaml $HOME/python/EXOZIPPy/examples/DC2018/configs/DC2018_128_mulens_hoggcap.yaml $HOME/python/EXOZIPPy/examples/DC2018/configs/DC2018_128_mulens_hoggcap_fitmurel.yaml $HOME/python/EXOZIPPy/examples/DC2018/configs/DC2018_128_mulens_hoggcap_observable.yaml $HOME/python/EXOZIPPy/examples/DC2018/configs/DC2018_128_mulens_hoggcap_pirel.yaml $HOME/python/EXOZIPPy/examples/DC2018/configs/DC2018_128_mulens_hoggcap_swapsonly.yaml $HOME/python/EXOZIPPy/examples/DC2018/configs/DC2018_128_mulens_hoggcap_thetae.yaml $HOME/python/EXOZIPPy/examples/DC2018/configs/DC2018_128_mulens_hoggcap_u0te.yaml $HOME/python/EXOZIPPy/examples/DC2018/configs/DC2018_128_severed_forensic.yaml $HOME/python/EXOZIPPy/examples/DC2018/configs/DC2018_128_severed_v3.yaml $HOME/python/EXOZIPPy/examples/DC2018/configs/DC2018_128_severed_v4.yaml $HOME/python/EXOZIPPy/examples/DC2018/configs/DC2018_128_severed_v5.yaml $HOME/python/EXOZIPPy/examples/DC2018/configs/DC2018_128_severed_v6.yaml $HOME/python/EXOZIPPy/examples/DC2018/configs/DC2018_128_severed_v7.yaml $HOME/python/EXOZIPPy/examples/DC2018/configs/DC2018_128_tightpriors.yaml $HOME/python/EXOZIPPy/examples/DC2018/events/062/DC2018_062.yaml $HOME/python/EXOZIPPy/examples/DC2018/events/152/DC2018_152.yaml $HOME/python/EXOZIPPy/examples/DC2018/events/152/base/DC2018_152_base.yaml $HOME/python/EXOZIPPy/examples/DC2018/events/152/obs/DC2018_152_obs.yaml $HOME/python/EXOZIPPy/examples/DC2018/events/194/DC2018_194.yaml $HOME/python/EXOZIPPy/examples/DC2018/events/223/DC2018_223.yaml 
echo "exit $?   $(date)"
