# /bin/sh
#$ -S /bin/sh
#$ -pe mthread 16
#$ -q mThC.q
#$ -cwd
#$ -j y
#$ -N sevfollow
#$ -o sevfollow.$JOB_ID.log
#
#   qsub dc128_severed_v3_followup.job
# Trace-direct rho vs rho_pred pull for severed-v3 (job 15377879), whose
# wrap-up was killed by the h_rss limit at 771 GB before writing any report.
# 16 slots for memory headroom: the trace is 4.2 GB and arviz loads it whole.

module purge
module load tools/python/3.13
export PATH="$HOME/miniconda3/bin:$PATH:$HOME/.local/bin"
source $HOME/miniconda3/etc/profile.d/conda.sh
conda activate exozippy
export PYTENSOR_FLAGS="base_compiledir=${TMPDIR:-/tmp}/pytensor_$JOB_ID"
# Single-threaded numerics: this is one long serial evaluation loop, and
# letting BLAS grab 16 threads per call only adds contention.
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1

cd $HOME/python/EXOZIPPy/examples/DC2018
echo "sha: $(git -C $HOME/python/EXOZIPPy rev-parse --short HEAD)"
python -u dc128_severed_v3_followup.py
