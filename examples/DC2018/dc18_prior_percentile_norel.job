# /bin/sh
#$ -S /bin/sh
#$ -pe mthread 4
#$ -q mThM.q
#$ -l use_himem=TRUE
#$ -cwd
#$ -j y
#$ -N priornorel
#$ -o sweep4/dc18_prior_percentile_norel.$JOB_ID.log
# 7.7.3 (1) control A: the prior MINUS the stellar relations (mann, torres, mamajek).
# mass / distance / pm / rv coordinates' own (uniform + bound) priors -- no
# stellar relations (mann, torres, mamajek), no radius/teff/av/feh terms.
module purge
module load tools/python/3.13
export PATH="$HOME/miniconda3/bin:$PATH:$HOME/.local/bin"
source $HOME/miniconda3/etc/profile.d/conda.sh
conda activate exozippy
export PYTENSOR_FLAGS="base_compiledir=${TMPDIR:-/tmp}/pytensor_priorimf"
export OMP_NUM_THREADS=1
cd $HOME/python/EXOZIPPy/examples/DC2018
echo "commit $(git -C $HOME/python/EXOZIPPy rev-parse --short HEAD)   $(date)"
KEEP='^(?!.*(mulensinstrument|mann|torres|mamajek))'
for ev in 047 069; do
  python -u dc18_prior_percentile.py --event $((10#$ev)) --run-dir sweep4/$ev --keep "$KEEP" --tag _norel 2>&1 | grep -v "DEBUG\|Warning\|warn\|^\["
done
echo "exit $?   $(date)"
