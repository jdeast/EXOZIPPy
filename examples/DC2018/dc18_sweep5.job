# /bin/sh
# ----------------Parameters---------------------- #
#$ -S /bin/sh
#$ -pe mthread 32-64
#$ -q lThM.q
# The M queues carry a FORCED boolean complex, use_himem, so the queue
# change alone yields "does not request 'forced' resource" and the job
# is unschedulable.  Both lines are needed; `qsub -w v` is the check.
#$ -l use_himem=TRUE
#$ -cwd
#$ -j y
#$ -N dc18swp5
#$ -t 1
#$ -o sweep5/dc18_sweep5.$JOB_ID.$TASK_ID.log
#
# QUEUE CHOICE IS THE MEMORY FIX -- measured 2026-09-16, and it is not what
# it looks like.  h_rss is an ACCOUNTING limit, not a memory one: execd
# enforces it by SUMMING per-process RSS (these jobs get no memory cgroup,
# only a freezer one), and `ps` RSS counts shared copy-on-write pages in
# every process that maps them.  The wrap-up polish forks one worker per
# granted slot from a parent holding the whole trace, so the trace is
# charged once per worker while the kernel allocates it once.  Measured live
# on event 062: SGE charging 495.8 GB while the node reported 22 GB of 503
# used and 477 free.  It killed the job anyway.
# THREE of the six sweep events lost finished reports to this -- 008
# (576.1 GB), 062 (553.0 GB), 128 (579.4 GB) -- every one on a node with
# hundreds of GB free.  062 died during "mode identification + result
# tables", after its hot-chain discovery had already found a new basin.
#
# WHY MORE SLOTS CANNOT FIX IT: the charge is ~slots x 7.6 GB against a
# ceiling of slots x 8 GB, so the ratio is ~0.95 whatever the slot count --
# which is why all three died at 0.95-1.13x their ceiling.
# WHY REQUESTING A BIGGER h_rss CANNOT FIX IT: on the C queue h_rss is
# queue-FIXED (qf:h_rss=8.000G), so asking for more yields "verification: no
# suitable queues" and the job sits in qw forever.  Verified with
# `qsub -w v`; do not re-try it.
# WHAT WORKS: the M (high-memory) queues offer h_rss=450G per slot with the
# SAME h_rt=1440:15:00 and, measured, MORE free slots than the C queue
# (4,473 against 4,200).  A drop-in.
#
# SWEEP 5 (2026-10-04): ONE event, 062, with the current recipe (Vega-correct
# zeropoints, anchored sight line, blend tie, mamajek) -- TASK 11 asks to
# re-measure 062's 52-nat wrong-q preference (dc18_logp_terms.py) after the
# zeropoint fix, which was computed with the mis-scaled source flux feeding
# rho.  062 is NOT static (PR #318 took it out of the static sweep), so this
# is the static model fit as a DIAGNOSTIC of the q preference only, not a
# recovery claim.
# SWEEP 4 (2026-09-28) = sweep3 + ONE block: `mamajek: [{star: Lens,
# constrain: [teff]}]` on every event (PR #340), tying the lens's Teff to
# its mass along the Pecaut & Mamajek dwarf sequence at a 4% floor.  sweep3
# recovered the lens mass 4.9x (047), 3.4-5.5x (069), 2.3x (103), 0.70x
# (152), 1.47x (194), 2-6x (223) of truth because nothing photometric read
# the lens Teff and its posterior width grew with the lens mass (notes
# 2026-09-25/27).  On 194 alone the tie halved the Teff width and moved
# M_l 0.44 -> 0.338 (truth 0.30); the heavy-lens events are where the
# gain should be largest.  The configs differ from sweep3/ by that block
# only (diffed 2026-09-28); explore tier, 5000 draws, tune 5000.
#
# THE DC2018 SWEEP: six events, one identical recipe, no MMEXOFAST.
#
#   qsub -t 1-6 dc18_sweep.job
#
# Every config was written by dc18_sweep_config.py from rules that are the
# same for all six -- see that file's docstring for each rule and for what
# was deliberately NOT carried over from v7 (the log_theta_E start that used
# the answer, MMEXOFAST, and the solar pins).  Seeds come from dc18_seed.py,
# a 3-second PSPL peak fit that reproduces MMEXOFAST's t_0/u_0/t_E to 4-5
# significant figures on every event where MMEXOFAST produced one, and
# produces seeds for 008 and 062 where MMEXOFAST produced none.
#
# ONE TASK = ONE EVENT.  They are independent; a failure in one says nothing
# about the others, which is the point of running them identically.
#
# SLOTS ARE REQUESTED AS A RANGE (32-64) and `sampler.cores` is then set
# from $NSLOTS on the node.  Both halves are needed and neither works alone:
# mthread's allocation_rule is $pe_slots, so all slots must land on ONE
# host, and lThC.q had 3,510 of 4,616 slots free while a flat 64-slot
# request still would not start -- the cluster was not full, the individual
# NODES were.  A range schedules against whatever a node has spare.  But a
# config still claiming `cores: 64` after SGE granted 32 oversubscribes the
# node 2x, which is precisely review 2.4.11's defect, so dc18_set_cores.py
# writes a per-job copy of the config with the granted count.  It copies
# rather than edits: the committed configs are read by neighbouring array
# tasks, and what ran stays reproducible from the committed file plus
# $NSLOTS.
#
# ----------------Modules------------------------- #
module purge
module load tools/python/3.13
export PATH="$HOME/miniconda3/bin:$PATH:$HOME/.local/bin"
source $HOME/miniconda3/etc/profile.d/conda.sh
conda activate exozippy

# PyTensor's compile lock uses flock(); ~/.pytensor is on NFS here and this
# cluster's NFS client drops advisory locks mid-compile (ENOLCK/ESTALE).
export PYTENSOR_FLAGS="base_compiledir=${TMPDIR:-/tmp}/pytensor"

cd $HOME/python/EXOZIPPy/examples/DC2018
ev=$(sed -n "${SGE_TASK_ID}p" sweep5/events.txt)
if [ -z "$ev" ]; then
    echo "No event for task ${SGE_TASK_ID:-<unset>}" >&2
    exit 1
fi

echo "event $ev   commit $(git -C $HOME/python/EXOZIPPy rev-parse --short HEAD)   $(date)"
cfg="${TMPDIR:-/tmp}/$(basename ${ev})_$$.yaml"
python dc18_set_cores.py "sweep5/$ev/DC2018_$ev.yaml" "$cfg" --cores "${NSLOTS:?NSLOTS unset}"
exozippy "$cfg"
echo "exit $?   $(date)"
