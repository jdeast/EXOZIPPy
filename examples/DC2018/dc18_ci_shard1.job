# /bin/sh
#$ -S /bin/sh
#$ -pe mthread 8
#$ -q mThM.q
#$ -l use_himem=TRUE
#$ -cwd
#$ -j y
#$ -N cishard1
#$ -o ci_shard1.$JOB_ID.log
# Master CI has been red since #382: shard 1 of 4 is CANCELLED after 40-85
# min on every platform while the other shards pass.  Run shard 1's file
# list (scripts/pytest_shard.py --shard 1 --of 4, same split CI uses) with
# the suite's default -n 6 --dist loadfile and a faulthandler dump at 550 s
# so a test that blocks past the 600 s signal timeout names itself.
module purge
module load tools/python/3.13
export PATH="$HOME/miniconda3/bin:$PATH:$HOME/.local/bin"
source $HOME/miniconda3/etc/profile.d/conda.sh
conda activate exozippy
export PYTENSOR_FLAGS="base_compiledir=${TMPDIR:-/tmp}/pytensor_cishard1"
cd $HOME/python/EXOZIPPy
echo "branch $(git branch --show-current) $(git rev-parse --short HEAD)   $(date)"
timeout 85m python -m pytest -q -p no:cacheprovider -o faulthandler_timeout=550 --durations=25 /home/jeastman/python/EXOZIPPy/tests/test_astrometric_microlensing.py /home/jeastman/python/EXOZIPPy/tests/test_astrometry_plot_data.py /home/jeastman/python/EXOZIPPy/tests/test_bare_param_entries.py /home/jeastman/python/EXOZIPPy/tests/test_bc_grid_refuses_missing.py /home/jeastman/python/EXOZIPPy/tests/test_bc_incremental.py /home/jeastman/python/EXOZIPPy/tests/test_chen.py /home/jeastman/python/EXOZIPPy/tests/test_chord.py /home/jeastman/python/EXOZIPPy/tests/test_citation_field.py /home/jeastman/python/EXOZIPPy/tests/test_component_override_channel.py /home/jeastman/python/EXOZIPPy/tests/test_convergence.py /home/jeastman/python/EXOZIPPy/tests/test_dc18_evaluate_observables.py /home/jeastman/python/EXOZIPPy/tests/test_dc18_sweep_t0_pad.py /home/jeastman/python/EXOZIPPy/tests/test_dopptom.py /home/jeastman/python/EXOZIPPy/tests/test_ecc_barrier.py /home/jeastman/python/EXOZIPPy/tests/test_ensure_lp.py /home/jeastman/python/EXOZIPPy/tests/test_fitmurel.py /home/jeastman/python/EXOZIPPy/tests/test_getdata.py /home/jeastman/python/EXOZIPPy/tests/test_hierarchical_orbit.py /home/jeastman/python/EXOZIPPy/tests/test_instrument_base.py /home/jeastman/python/EXOZIPPy/tests/test_instrument_mask.py /home/jeastman/python/EXOZIPPy/tests/test_integration_ob09020.py /home/jeastman/python/EXOZIPPy/tests/test_introspect.py /home/jeastman/python/EXOZIPPy/tests/test_ltt_reporting.py /home/jeastman/python/EXOZIPPy/tests/test_mamajek_relation.py /home/jeastman/python/EXOZIPPy/tests/test_manifest_interpreter.py /home/jeastman/python/EXOZIPPy/tests/test_mkparam_in_memory.py /home/jeastman/python/EXOZIPPy/tests/test_mkparam_multiseed.py /home/jeastman/python/EXOZIPPy/tests/test_mkparam_roundtrip.py /home/jeastman/python/EXOZIPPy/tests/test_mkticsed.py /home/jeastman/python/EXOZIPPy/tests/test_mode_evidence.py /home/jeastman/python/EXOZIPPy/tests/test_mu_rel_geo.py /home/jeastman/python/EXOZIPPy/tests/test_mulens_acceptance_b.py /home/jeastman/python/EXOZIPPy/tests/test_mulens_plot_parity.py /home/jeastman/python/EXOZIPPy/tests/test_mulens_review_fixes.py /home/jeastman/python/EXOZIPPy/tests/test_multiplanet.py /home/jeastman/python/EXOZIPPy/tests/test_near_bound_remedy.py /home/jeastman/python/EXOZIPPy/tests/test_node_degeneracy.py /home/jeastman/python/EXOZIPPy/tests/test_optional_parameter_file.py /home/jeastman/python/EXOZIPPy/tests/test_overdisperse_declaration.py /home/jeastman/python/EXOZIPPy/tests/test_param_specificity.py /home/jeastman/python/EXOZIPPy/tests/test_parameter_logic.py /home/jeastman/python/EXOZIPPy/tests/test_pharmacokinetics_degeneracy.py /home/jeastman/python/EXOZIPPy/tests/test_polish.py /home/jeastman/python/EXOZIPPy/tests/test_polish_trust_region.py /home/jeastman/python/EXOZIPPy/tests/test_posterior_shapes.py /home/jeastman/python/EXOZIPPy/tests/test_pspl_symbolic_vs_op.py /home/jeastman/python/EXOZIPPy/tests/test_public_api.py /home/jeastman/python/EXOZIPPy/tests/test_pytensor_fallback.py /home/jeastman/python/EXOZIPPy/tests/test_rm_ltt.py /home/jeastman/python/EXOZIPPy/tests/test_robust_cap.py /home/jeastman/python/EXOZIPPy/tests/test_robust_likelihood.py /home/jeastman/python/EXOZIPPy/tests/test_run_wrapup_guards.py /home/jeastman/python/EXOZIPPy/tests/test_rv_model.py /home/jeastman/python/EXOZIPPy/tests/test_sampler_kwarg_plumbing.py /home/jeastman/python/EXOZIPPy/tests/test_sed_flux_constraints.py /home/jeastman/python/EXOZIPPy/tests/test_sed_magsys.py /home/jeastman/python/EXOZIPPy/tests/test_sed_spectra_plot.py /home/jeastman/python/EXOZIPPy/tests/test_solve_api.py /home/jeastman/python/EXOZIPPy/tests/test_symbolic_translation.py /home/jeastman/python/EXOZIPPy/tests/test_torres.py /home/jeastman/python/EXOZIPPy/tests/test_transit_exofast_parity.py /home/jeastman/python/EXOZIPPy/tests/test_whitening.py /home/jeastman/python/EXOZIPPy/tests/test_whitening_anchor.py /home/jeastman/python/EXOZIPPy/tests/test_yaml_booleans.py /home/jeastman/python/EXOZIPPy/tests/test_zenodo_assets.py  2>&1 | tail -150
echo "exit $?   $(date)"
