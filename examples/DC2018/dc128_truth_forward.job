# /bin/sh
#$ -S /bin/sh
#$ -pe mthread 4
#$ -q sThC.q
#$ -cwd
#$ -j y
#$ -N dc128fwd
#$ -o dc128_truth_forward.$JOB_ID.log

module purge
module load tools/python/3.13
export PATH="$HOME/miniconda3/bin:$PATH:$HOME/.local/bin"
source $HOME/miniconda3/etc/profile.d/conda.sh
conda activate exozippy

export PYTENSOR_FLAGS="base_compiledir=${TMPDIR:-/tmp}/pytensor_fwd"

cd $HOME/python/EXOZIPPy/examples/DC2018
python -u dc128_truth_forward.py ${ALPHA:--50.4} ${U0SIGN:-1}
